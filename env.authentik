# Django app config when authenticating against Authentik (local docker compose).
PY_ENV=development
PORT=3001
ALLOWED_HOSTS=localhost,127.0.0.1

SESSION_SECRET=0e109d5fd5f792c8060afbf51b08c5712db548ff8c008c2e1d5049f5b267cd6f
SESSION_DURATION=3600

OIDC_PROVIDER_NAME=Authentik

# Authentik's issuer lives under /application/o/<app-slug>.
# authentik:9000 must resolve identically from the browser AND this container.
OIDC_ISSUER=http://authentik:9000/application/o/django

OIDC_CLIENT_ID=django-app
OIDC_CLIENT_SECRET=07bbe54c1d81ca9458f772fed8a3bea5520efbdc8357d527

OIDC_CALLBACK_URL=http://localhost:3001/auth/callback
OIDC_POST_LOGIN_URL=/profile
OIDC_POST_LOGOUT_URL=http://localhost:3001/auth/logout/callback
