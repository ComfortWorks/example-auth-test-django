# Django app config when authenticating against Keycloak (local docker compose).
PY_ENV=development
PORT=3000
ALLOWED_HOSTS=localhost,127.0.0.1

SESSION_SECRET=0e109d5fd5f792c8060afbf51b08c5712db548ff8c008c2e1d5049f5b267cd6f
SESSION_DURATION=3600

# Display name shown on the sign-in button.
OIDC_PROVIDER_NAME=Keycloak

# Issuer base URL. Discovery is looked up at
# <issuer>/.well-known/openid-configuration automatically.
# NOTE: keycloak:8080 must resolve identically from the browser AND this
# container (see the /etc/hosts step in the guide) so the OIDC issuer matches.
OIDC_ISSUER=http://keycloak:8080/realms/demo

OIDC_CLIENT_ID=django-app
OIDC_CLIENT_SECRET=4595ee67699f246fdeba1033c50c3f90ef6494b37d9fa525

OIDC_CALLBACK_URL=http://localhost:3000/auth/callback
OIDC_POST_LOGIN_URL=/profile
OIDC_POST_LOGOUT_URL=http://localhost:3000/auth/logout/callback
