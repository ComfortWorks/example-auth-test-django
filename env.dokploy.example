# =====================================================================
# Dokploy environment variables (paste into the project's Environment tab).
# Set the values for the IdP you're deploying. Generate fresh secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Generate all secrets at once:
#   python3 -c "import secrets as s; [print(f'{k}={s.token_hex(n)}') for k,n in \
#   [('OIDC_CLIENT_SECRET',24),('SESSION_SECRET',32),('AK_SECRET_KEY',32),\
#   ('AK_DB_PASSWORD',16),('AK_BOOTSTRAP_TOKEN',24),('KC_DB_PASSWORD',16),\
#   ('ZITADEL_DB_PASSWORD',16)]]"
#
# ZITADEL_MASTERKEY is special — EXACTLY 32 characters (not hex). Generate with:
#   python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
# =====================================================================

# ---- Active profile (REQUIRED) ---------------------------------------
# Every service in docker-compose.dokploy.yml is gated behind a Compose
# profile. Without this set, NO services start and the deploy fails with
# "No such container: select-a-container". Pick exactly one:
COMPOSE_PROFILES=keycloak                            # or: authentik  or: zitadel

# ---- Public domains (point A records at your server first) -----------
# MUST be two different hostnames (subdomains of one domain is fine) — the app
# and the IdP are routed by Traefik per-hostname and cannot share one.
APP_DOMAIN=app.staging.example.com
IDP_DOMAIN=id.staging.example.com

# ---- Django app ------------------------------------------------------
SESSION_SECRET=change-me-64-hex-chars               # token_hex(32)
# OIDC_CLIENT_ID: "django-app" for Keycloak/Authentik (set in realm/blueprint).
# For ZITADEL, replace it with the Console-GENERATED client ID after you create
# the app (a long value you copy out — see GUIDE §7.9 / §7.10).
OIDC_CLIENT_ID=django-app
# Shared OIDC client secret — token_hex(24). How it reaches each IdP differs:
#   Keycloak : also set it in keycloak/realm-demo.json ("secret" field)
#   Authentik: the blueprint reads THIS var automatically (nothing to copy)
#   ZITADEL  : ZITADEL GENERATES the secret when you create the app; copy it
#              FROM the Console INTO this var, then redeploy `web` (not shared).
OIDC_CLIENT_SECRET=change-me-shared-with-idp

# Pick ONE set depending on the IdP profile (comment out the others):
# Keycloak:
OIDC_ISSUER=https://id.staging.example.com/realms/demo
OIDC_PROVIDER_NAME=Keycloak
# Authentik:
# OIDC_ISSUER=https://id.staging.example.com/application/o/django
# OIDC_PROVIDER_NAME=Authentik
# ZITADEL (issuer is the HOST ROOT — no path):
# OIDC_ISSUER=https://id.staging.example.com
# OIDC_PROVIDER_NAME=ZITADEL

# ---- Keycloak profile only -------------------------------------------
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-strong
KC_DB_PASSWORD=change-me-db

# ---- Authentik profile only ------------------------------------------
# NOTE: AK_ADMIN_* / AK_BOOTSTRAP_TOKEN below feed the akadmin bootstrap, which
# runs ONCE on first boot (when the DB is empty). Changing them later does
# nothing to an existing akadmin — recover via `ak create_recovery_key 10
# akadmin` or wipe the authentik-db-data volume to re-bootstrap. The compose
# file passes these to BOTH authentik-server and authentik-worker; the worker
# is the container that actually performs the bootstrap.
AK_SECRET_KEY=change-me-64-hex-chars                # token_hex(32); DO NOT change after first boot
AK_DB_PASSWORD=change-me-db                          # token_hex(16)
AK_ADMIN_EMAIL=admin@example.com
AK_ADMIN_PASSWORD=change-me-strong
AK_BOOTSTRAP_TOKEN=change-me-token                   # token_hex(24)
# ---- ZITADEL profile only --------------------------------------------
# Masterkey: EXACTLY 32 characters (see generator at top). Set BEFORE first boot,
# NEVER change it — it encrypts data at rest; changing it loses access to it.
ZITADEL_MASTERKEY=change-me-exactly-32-characters!   # must be 32 chars
ZITADEL_DB_PASSWORD=change-me-db                     # token_hex(16)
# First-instance admin (ONE-SHOT: applied only when the DB is empty; changing
# later does nothing — wipe zitadel-db-data to re-bootstrap). Password must meet
# default complexity: >=8 chars with upper + lower + number + symbol.
# !! LOGIN NAME is <username>@zitadel.<IDP_DOMAIN> — e.g. with the values below
#    and IDP_DOMAIN=id.staging.example.com you log in as:
#        admin@zitadel.id.staging.example.com
ZITADEL_ADMIN_USERNAME=admin
ZITADEL_ADMIN_PASSWORD=Change-me-Str0ng!
ZITADEL_ADMIN_EMAIL=admin@example.com
